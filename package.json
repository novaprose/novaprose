{
  "name": "novaprose-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "pnpm --filter @novaprose/playground dev",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:deep": "node scripts/test-deep.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "node apps/site/scripts/sync-docs.mjs && prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && node scripts/i18n.mjs check && node scripts/check-english.mjs && node apps/site/scripts/sync-docs.mjs --check",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "sr": "playwright test -c screen-reader/playwright.config.ts",
    "perf": "playwright test -c perf/playwright.config.ts",
    "release:pack": "pnpm build && node scripts/release-pack.mjs",
    "size": "node scripts/size.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "verify:release": "pnpm release:pack && pnpm size && pnpm check:packages",
    "verify:examples": "node scripts/verify-examples.mjs",
    "icons": "node scripts/icons.mjs && prettier --write packages/core/src/ui/icons.ts apps/site/src/components/site/icons.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.17.0",
    "@guidepup/guidepup": "^0.40.0",
    "@guidepup/playwright": "^0.21.0",
    "@playwright/test": "^1.49",
    "@primer/octicons": "^19.43.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "5.1.2",
    "esbuild": "0.28.2",
    "eslint": "^9.17.0",
    "fast-check": "^4.11.0",
    "jsdom": "^31.0.1",
    "lucide-static": "^1.80.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.1.2"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm check",
    "commit-msg": "node scripts/commit-msg.mjs $1"
  },
  "pnpm": {
    "overrides": {
      "js-beautify>glob": "^14.0.6",
      "editorconfig>minimatch": "^11.0.9"
    }
  }
}

{
  "name": "@novaprose/vue",
  "version": "0.6.0",
  "description": "NovaProse rich text editor for Vue 3: v-model component and composables (useEditor, useEditorState, useCommand), Nuxt-safe.",
  "keywords": [
    "vue",
    "vue3",
    "wysiwyg",
    "rich-text-editor",
    "editor",
    "prosemirror",
    "nuxt",
    "novaprose"
  ],
  "license": "MIT",
  "author": "NovaProse <hello@novaprose.com>",
  "homepage": "https://novaprose.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaprose/novaprose.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/novaprose/novaprose/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@novaprose/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "prosemirror-state": "^1.4.3",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}

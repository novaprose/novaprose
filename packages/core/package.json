{
  "name": "@novaprose/core",
  "version": "0.7.0",
  "description": "NovaProse: embeddable rich text (WYSIWYG) editor built on ProseMirror. Secure by default, accessible, TinyMCE-compatible plugin and toolbar names.",
  "keywords": [
    "wysiwyg",
    "rich-text-editor",
    "editor",
    "prosemirror",
    "contenteditable",
    "html-editor",
    "novaprose"
  ],
  "license": "MIT",
  "author": "NovaProse <hello@novaprose.com>",
  "homepage": "https://novaprose.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaprose/novaprose.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/novaprose/novaprose/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/plugins/index.ts",
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/chunk-*.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./markdown": {
      "import": {
        "types": "./dist/markdown.d.ts",
        "default": "./dist/markdown.js"
      },
      "require": {
        "types": "./dist/markdown.d.cts",
        "default": "./dist/markdown.cjs"
      }
    },
    "./docx": {
      "import": {
        "types": "./dist/docx.d.ts",
        "default": "./dist/docx.js"
      },
      "require": {
        "types": "./dist/docx.d.cts",
        "default": "./dist/docx.cjs"
      }
    },
    "./html-rules": {
      "import": {
        "types": "./dist/html-rules.d.ts",
        "default": "./dist/html-rules.js"
      },
      "require": {
        "types": "./dist/html-rules.d.cts",
        "default": "./dist/html-rules.cjs"
      }
    },
    "./i18n/*": {
      "import": {
        "types": "./dist/i18n/*.d.ts",
        "default": "./dist/i18n/*.js"
      },
      "require": {
        "types": "./dist/i18n/*.d.cts",
        "default": "./dist/i18n/*.cjs"
      }
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "dist",
    "src/style.css",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "highlight.js": "^11",
    "markdown-it": "^15",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-markdown": "^1.14",
    "prosemirror-model": "^1.24.1",
    "prosemirror-schema-list": "^1.5.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.37.1",
    "temml": "^0.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "docx": "^9"
  }
}

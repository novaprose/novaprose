---
/**
 * Layout of the product pages (home, pricing, cloud, privacy): own header and footer, the dot
 * background, and the same theme setting as the documentation (the starlight-theme key).
 */
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/marketing.css';
import DotField from '../components/site/DotField.astro';
import Icon from '../components/site/Icon.astro';
import logo from '../assets/logo.svg?url';
import logoDark from '../assets/logo-dark.svg?url';
import { t } from '../i18n/site';

interface Props {
  /** Page path: '/', '/pricing/'. */
  path: string;
  title?: string;
  description?: string;
}
const { path, title, description } = Astro.props;
const site = 'https://novaprose.com';
const pageTitle = title ? `${title} — NovaProse` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const nav = [
  { href: '/#features', label: t.nav.features },
  { href: '/demo/collaboration/', label: t.nav.demo },
  { href: '/pricing/', label: t.nav.pricing, current: path === '/pricing/' },
  { href: '/getting-started/', label: t.nav.docs },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`${site}${path}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NovaProse" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${site}${path}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NovaProse: the rich text editor with collaboration built in" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfaff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0c18" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // The theme before the first paint (no flash); the same key as the documentation.
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeMode = theme;
      })();
    </script>
  </head>
  <body class="np-site">
    <DotField />
    <a class="np-skip" href="#main">{t.nav.skip}</a>
    <header class="np-header">
      <div class="np-container np-header-row">
        <a class="np-brand" href="/" aria-label="NovaProse home">
          <img class="np-logo-light" src={logo} alt="" width="34" height="34" />
          <img class="np-logo-dark" src={logoDark} alt="" width="34" height="34" />
          <span>NovaProse</span>
        </a>
        <nav class="np-nav" id="np-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="np-nav-tools">
            <a
              class="np-icon-btn"
              href="https://github.com/novaprose/novaprose"
              aria-label="NovaProse on GitHub"
              title="GitHub"
            >
              <Icon name="github" size={20} />
            </a>
            <button
              type="button"
              class="np-icon-btn"
              id="np-theme"
              data-labels={JSON.stringify({ light: t.nav.themeLight, dark: t.nav.themeDark })}
              aria-label={t.nav.theme}
              title={t.nav.theme}
            >
              <span class="np-theme-icon" data-for="light"><Icon name="sun" size={20} /></span>
              <span class="np-theme-icon" data-for="dark"><Icon name="moon" size={20} /></span>
            </button>
            <a class="np-btn np-btn-primary np-btn-sm" href="/getting-started/">{t.nav.start}</a>
          </div>
        </nav>
        <button
          type="button"
          class="np-icon-btn np-menu-btn"
          aria-controls="np-nav"
          aria-expanded="false"
          aria-label={t.nav.menu}
        >
          <span class="np-menu-icon" data-for="closed"><Icon name="menu" size={22} /></span>
          <span class="np-menu-icon" data-for="open"><Icon name="close" size={22} /></span>
        </button>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="np-footer">
      <div class="np-container np-footer-grid">
        <div>
          <a class="np-brand" href="/" aria-label="NovaProse home">
            <img class="np-logo-light" src={logo} alt="" width="30" height="30" />
            <img class="np-logo-dark" src={logoDark} alt="" width="30" height="30" />
            <span>NovaProse</span>
          </a>
          <p class="np-muted">{t.footer.tagline}</p>
        </div>
        <nav aria-labelledby="footer-product">
          <h2 id="footer-product">{t.footer.product}</h2>
          <ul>
            <li><a href="/#features">{t.nav.features}</a></li>
            <li><a href="/demo/collaboration/">{t.nav.demo}</a></li>
            <li><a href="/pricing/">{t.nav.pricing}</a></li>
            <li><a href="/cloud/">NovaProse Cloud</a></li>
          </ul>
        </nav>
        <nav aria-labelledby="footer-resources">
          <h2 id="footer-resources">{t.footer.resources}</h2>
          <ul>
            <li><a href="/getting-started/">{t.nav.docs}</a></li>
            <li><a href="/migrate/">{t.footer.migrate}</a></li>
            <li><a href="/project/testing/">{t.footer.testing}</a></li>
            <li><a href="/changelog/">{t.footer.changelog}</a></li>
          </ul>
        </nav>
        <nav aria-labelledby="footer-project">
          <h2 id="footer-project">{t.footer.project}</h2>
          <ul>
            <li><a href="https://github.com/novaprose/novaprose">GitHub</a></li>
            <li>
              <a href="https://github.com/novaprose/novaprose/blob/main/SECURITY.md">
                {t.footer.security}
              </a>
            </li>
            <li><a href="/project/accessibility/">{t.footer.accessibility}</a></li>
            <li><a href="/privacy/">{t.footer.privacy}</a></li>
            <li><a href="mailto:hello@novaprose.com">{t.footer.contact}</a></li>
          </ul>
        </nav>
      </div>
      <div class="np-container np-footer-bottom">
        <p>© 2026 NovaProse · MIT license · {t.footer.rights}</p>
      </div>
    </footer>

    <script>
      // The header gets a border once the page scrolls under it.
      const header = document.querySelector<HTMLElement>('.np-header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // The mobile menu: a popup that closes with Esc, a click outside or a chosen link.
      const menuBtn = document.querySelector<HTMLButtonElement>('.np-menu-btn');
      const nav = document.getElementById('np-nav');
      const setMenu = (open: boolean, restoreFocus = false) => {
        menuBtn?.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
        if (!open && restoreFocus) menuBtn?.focus();
      };
      menuBtn?.addEventListener('click', () => {
        setMenu(menuBtn.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav?.classList.contains('is-open')) setMenu(false, true);
      });
      document.addEventListener('click', (event) => {
        if (!nav?.classList.contains('is-open')) return;
        const target = event.target as Node;
        if (menuBtn?.contains(target)) return;
        if (!nav.contains(target) || (target as Element).closest?.('a')) setMenu(false);
      });

      // Theme: follows the system until chosen; a click always switches light ↔ dark.
      // The key is shared with the documentation (starlight-theme).
      const themeBtn = document.getElementById('np-theme');
      const labels = JSON.parse(themeBtn?.dataset.labels ?? '{}') as Record<string, string>;
      const baseLabel = themeBtn?.getAttribute('aria-label') ?? '';
      const resolved = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      const show = () => {
        const mode = resolved();
        document.documentElement.dataset.themeMode = mode;
        const label = `${baseLabel}: ${labels[mode] ?? mode}`;
        themeBtn?.setAttribute('title', label);
        themeBtn?.setAttribute('aria-label', label);
      };
      show();
      // The colors fade into the other theme (np-theme-fade in marketing.css). The class goes on before
      // the switch: the star field reads the new colors at once, and a transition starts only when the
      // style already has it at that moment.
      let fadeTimer = 0;
      const fadeColors = () => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('np-theme-fade');
        window.clearTimeout(fadeTimer);
        fadeTimer = window.setTimeout(
          () => document.documentElement.classList.remove('np-theme-fade'),
          500,
        );
      };
      themeBtn?.addEventListener('click', () => {
        const next = resolved() === 'dark' ? 'light' : 'dark';
        localStorage.setItem('starlight-theme', next);
        fadeColors();
        document.documentElement.dataset.theme = next;
        show();
      });
    </script>
  </body>
</html>

---
/**
 * Шаблон продуктовых страниц (главная, цены, облако, политика): своя шапка и подвал,
 * два языка, тема общая с документацией (тот же ключ starlight-theme).
 */
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/marketing.css';
import Icon from '../components/site/Icon.astro';
import logo from '../assets/logo.svg?url';
import { dict, localePath, type Lang } from '../i18n/site';

interface Props {
  lang: Lang;
  /** Путь страницы без языка: '/', '/pricing/'. */
  path: string;
  title?: string;
  description?: string;
}
const { lang, path, title, description } = Astro.props;
const t = dict[lang];
const site = 'https://novaprose.com';
const pageTitle = title ? `${title} — NovaProse` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const other: Lang = lang === 'en' ? 'ru' : 'en';
const nav = [
  { href: `${localePath(lang, '/')}#features`, label: t.nav.features },
  { href: '/demo/collaboration/', label: t.nav.demo },
  { href: localePath(lang, '/pricing/'), label: t.nav.pricing, current: path === '/pricing/' },
  { href: '/getting-started/', label: t.nav.docs },
];
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`${site}${localePath(lang, path)}`} />
    <link rel="alternate" hreflang="en" href={`${site}${localePath('en', path)}`} />
    <link rel="alternate" hreflang="ru" href={`${site}${localePath('ru', path)}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${path}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={`${site}${localePath(lang, path)}`} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta name="theme-color" content="#4f46e5" />
    <script is:inline>
      // Тема до отрисовки (без мигания): тот же ключ, что у документации.
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="np-site">
    <a class="np-skip" href="#main">{t.nav.skip}</a>
    <header class="np-header">
      <div class="np-container np-header-row">
        <a class="np-brand" href={localePath(lang, '/')} aria-label="NovaProse">
          <img src={logo} alt="" width="32" height="32" />
          <span>NovaProse</span>
        </a>
        <nav class="np-nav" id="np-nav" aria-label={t.nav.menu}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="np-nav-tools">
            <a
              class="np-icon-btn"
              href="https://github.com/novaprose/novaprose"
              aria-label="GitHub"
              title="GitHub"
            >
              <Icon name="github" size={20} />
            </a>
            <a
              class="np-lang"
              href={localePath(other, path)}
              hreflang={other}
              lang={other}
              aria-label={`${t.nav.language}: ${other === 'en' ? 'English' : 'Русский'}`}
            >
              <Icon name="language" size={18} />
              {other.toUpperCase()}
            </a>
            <button
              type="button"
              class="np-icon-btn"
              id="np-theme"
              data-labels={JSON.stringify({
                light: t.nav.themeLight,
                dark: t.nav.themeDark,
                auto: t.nav.themeAuto,
              })}
              aria-label={t.nav.theme}
              title={t.nav.theme}
            >
              <span class="np-theme-icon" data-for="light"><Icon name="sun" size={20} /></span>
              <span class="np-theme-icon" data-for="dark"><Icon name="moon" size={20} /></span>
            </button>
            <a class="np-btn np-btn-primary np-btn-sm" href="/getting-started/">{t.nav.start}</a>
          </div>
        </nav>
        <button
          type="button"
          class="np-icon-btn np-menu-btn"
          aria-controls="np-nav"
          aria-expanded="false"
          aria-label={t.nav.menu}
        >
          <Icon name="menu" size={22} />
        </button>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="np-footer">
      <div class="np-container np-footer-grid">
        <div>
          <a class="np-brand" href={localePath(lang, '/')}>
            <img src={logo} alt="" width="28" height="28" />
            <span>NovaProse</span>
          </a>
          <p class="np-muted">{t.footer.tagline}</p>
        </div>
        <nav aria-label={t.footer.product}>
          <h2>{t.footer.product}</h2>
          <ul>
            <li><a href={`${localePath(lang, '/')}#features`}>{t.nav.features}</a></li>
            <li><a href="/demo/collaboration/">{t.nav.demo}</a></li>
            <li><a href={localePath(lang, '/pricing/')}>{t.nav.pricing}</a></li>
            <li><a href={localePath(lang, '/cloud/')}>NovaProse Cloud</a></li>
          </ul>
        </nav>
        <nav aria-label={t.footer.resources}>
          <h2>{t.footer.resources}</h2>
          <ul>
            <li><a href="/getting-started/">{t.nav.docs}</a></li>
            <li><a href="/migrate/">{t.footer.migrate}</a></li>
            <li><a href="/changelog/">{t.footer.changelog}</a></li>
          </ul>
        </nav>
        <nav aria-label={t.footer.project}>
          <h2>{t.footer.project}</h2>
          <ul>
            <li><a href="https://github.com/novaprose/novaprose">GitHub</a></li>
            <li>
              <a href="https://github.com/novaprose/novaprose/blob/main/SECURITY.md"
                >{t.footer.security}</a
              >
            </li>
            <li><a href={localePath(lang, '/privacy/')}>{t.footer.privacy}</a></li>
            <li><a href="mailto:hello@novaprose.com">{t.footer.contact}</a></li>
          </ul>
        </nav>
      </div>
      <div class="np-container np-footer-bottom">
        <p>© 2026 NovaProse · MIT · {t.footer.rights}</p>
      </div>
    </footer>

    <script>
      // Мобильное меню.
      const menuBtn = document.querySelector<HTMLButtonElement>('.np-menu-btn');
      const nav = document.getElementById('np-nav');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') !== 'true';
        menuBtn.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && nav?.classList.contains('is-open')) {
          nav.classList.remove('is-open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.focus();
        }
      });

      // Тема: по умолчанию как в системе; клик всегда даёт видимую смену (светлая ↔ тёмная).
      // Ключ общий с документацией (starlight-theme).
      const themeBtn = document.getElementById('np-theme');
      const labels = JSON.parse(themeBtn?.dataset.labels ?? '{}') as Record<string, string>;
      const baseLabel = themeBtn?.getAttribute('aria-label') ?? '';
      const resolved = () => (document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      const show = () => {
        const mode = resolved();
        document.documentElement.dataset.themeMode = mode;
        const label = `${baseLabel}: ${labels[mode] ?? mode}`;
        themeBtn?.setAttribute('title', label);
        themeBtn?.setAttribute('aria-label', label);
      };
      show();
      themeBtn?.addEventListener('click', () => {
        const next = resolved() === 'dark' ? 'light' : 'dark';
        localStorage.setItem('starlight-theme', next);
        document.documentElement.dataset.theme = next;
        show();
      });
    </script>
  </body>
</html>

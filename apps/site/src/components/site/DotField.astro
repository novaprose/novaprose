---
/**
 * The background of the product pages: a starry sky that makes room around the mouse pointer; a tap or
 * click on empty space sends a ripple through it. Stars of different brightness twinkle at their own
 * pace, the brightest have a soft glow, and a few shine as four-pointed sparkles like the one in the
 * logo. In the dark theme the stars are light; in the light theme the same sky has dark, faded stars
 * and barely any glow (--np-dot-glow). A theme switch re-tints the stars over the same half second as
 * the page's colors. Decorative only. Stars fade out behind blocks of text so they never read as
 * punctuation. Draws a single still frame when the visitor prefers reduced motion, pauses while the tab
 * is hidden and redraws at a low rate while nobody interacts with it.
 */
---

<canvas class="np-dots" aria-hidden="true"></canvas>

<script>
  import { parseColor, type Rgba } from './dot-color';

  const TAU = Math.PI * 2;
  const RADIUS = 1.1; // dot radius at rest, CSS px
  const REACH = 150; // how far the pointer pushes dots
  const PUSH = 14; // largest displacement next to the pointer
  const GROW = 2.1; // extra radius next to the pointer
  const RIPPLE_SPEED = 0.5; // px per ms
  const RIPPLE_LIFE = 1500; // ms
  const RIPPLE_WIDTH = 42;
  const SWELL_SPEED = 0.0007; // radians per ms: one swell crosses a point every ~9 s
  const LEVELS = 8; // brightness steps (one fill call per step)
  const IDLE_FRAME = 1000 / 24; // the swell and the twinkling need no more than 24 frames per second
  const RETINT = 450; // ms: a theme switch re-tints the stars as long as the page's colors fade
  // The starry sky (dark theme).
  const GLOWING = 0.035; // share of stars with a glow
  const SPARKLING = 0.004; // share of stars drawn as four-pointed sparkles
  const TWINKLING = 0.6; // share of stars that twinkle noticeably
  // The header and text blocks on the bare background: dots behind them almost disappear.
  const TEXT_BLOCKS =
    '.np-header, .np-hero-copy, .np-section-head, .np-split-copy, .np-after-note, .np-demo-label, .np-demo-output, .np-prose';
  const TEXT_FADE = 0.12; // what is left of a dot in the middle of a text block
  const TEXT_FEATHER = 36; // px around a text block over which dots come back
  // Pressing these shouldn't make waves.
  const QUIET = 'a, button, input, select, textarea, summary, label, .nova-editor, .np-code';

  /** A stable pseudo-random number in [0, 1) for a grid cell: a star keeps its looks from frame to frame. */
  function noise(col: number, row: number, salt: number): number {
    let h = Math.imul(col + 7919 * salt, 374761393) ^ Math.imul(row + 104729 * salt, 668265263);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    h ^= h >>> 16;
    return (h >>> 0) / 4294967296;
  }

  /** A soft round glow, drawn once and stamped around bright stars. */
  function glowSprite([r, g, b]: Rgba): HTMLCanvasElement {
    const size = 64;
    const sprite = document.createElement('canvas');
    sprite.width = size;
    sprite.height = size;
    const ctx = sprite.getContext('2d');
    if (ctx) {
      const gradient = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
      gradient.addColorStop(0, `rgb(${r} ${g} ${b} / 0.6)`);
      gradient.addColorStop(0.22, `rgb(${r} ${g} ${b} / 0.24)`);
      gradient.addColorStop(1, `rgb(${r} ${g} ${b} / 0)`);
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, size, size);
    }
    return sprite;
  }

  function start(canvas: HTMLCanvasElement) {
    const context = canvas.getContext('2d');
    if (!context) return;
    const ctx = context;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const blocks = Array.from(document.querySelectorAll(TEXT_BLOCKS));

    let width = 0;
    let height = 0;
    let ratio = 1;
    let xs = new Float32Array(0);
    let ys = new Float32Array(0);
    // Per star (used in the dark theme): an offset from the grid, brightness, twinkle phase, speed and
    // depth, and its kind: 0 a plain star, 1 a star with a glow, 2 a sparkle.
    let jx = new Float32Array(0);
    let jy = new Float32Array(0);
    let mags = new Float32Array(0);
    let phases = new Float32Array(0);
    let speeds = new Float32Array(0);
    let depths = new Float32Array(0);
    let kinds = new Uint8Array(0);
    let base: Rgba = [124, 92, 196, 0.26];
    let active: Rgba = [106, 71, 168, 0.9];
    let sparkleColor: Rgba = [214, 219, 255, 1];
    let glowStrength = 1;
    let stars = false;
    let glow = glowSprite(active);
    // A theme switch: the colors the stars had and the ones they are heading to.
    type Palette = { base: Rgba; active: Rgba; sparkle: Rgba; glow: number };
    let retint: { from: Palette; to: Palette; start: number } | null = null;
    let colorsRead = false;

    const pointer = { x: 0, y: 0, targetX: 0, targetY: 0, strength: 0, target: 0 };
    const ripples: { x: number; y: number; born: number }[] = [];
    let frame = 0;
    let lastDraw = -Infinity;
    let running = false;
    let dirty = false; // the page scrolled: the text blocks moved under the dots
    let pending = 0;

    function readColors() {
      const style = getComputedStyle(document.documentElement);
      const strength = Number.parseFloat(style.getPropertyValue('--np-dot-glow'));
      const next: Palette = {
        base: parseColor(style.getPropertyValue('--np-dot'), base),
        active: parseColor(style.getPropertyValue('--np-dot-active'), active),
        sparkle: parseColor(style.getPropertyValue('--np-dot-sparkle'), sparkleColor),
        glow: Number.isFinite(strength) ? strength : 1,
      };
      stars = style.getPropertyValue('--np-dot-stars').trim() === '1';
      if (colorsRead && !reduced.matches) {
        // From the colors on screen now (a switch may come in the middle of another).
        const from: Palette = { base, active, sparkle: sparkleColor, glow: glowStrength };
        retint = { from, to: next, start: performance.now() };
      } else {
        applyPalette(next);
      }
      colorsRead = true;
    }

    function applyPalette(palette: Palette) {
      const changed = palette.active.some((value, i) => value !== active[i]);
      base = palette.base;
      active = palette.active;
      sparkleColor = palette.sparkle;
      glowStrength = palette.glow;
      if (changed || !colorsRead) glow = glowSprite(active);
    }

    /** The colors part of the way from one theme to the other (t from 0 to 1, eased). */
    function retintStep(time: number) {
      if (!retint) return;
      const t = Math.min(1, Math.max(0, (time - retint.start) / RETINT));
      const k = t * t * (3 - 2 * t);
      const mix = (a: Rgba, b: Rgba): Rgba => [
        a[0] + (b[0] - a[0]) * k,
        a[1] + (b[1] - a[1]) * k,
        a[2] + (b[2] - a[2]) * k,
        a[3] + (b[3] - a[3]) * k,
      ];
      const { from, to } = retint;
      applyPalette({
        base: mix(from.base, to.base),
        active: mix(from.active, to.active),
        sparkle: mix(from.sparkle, to.sparkle),
        glow: from.glow + (to.glow - from.glow) * k,
      });
      if (t >= 1) retint = null;
    }

    /** Sizes the canvas to its CSS box; false when nothing changed. */
    function layout(): boolean {
      const nextWidth = canvas.clientWidth;
      const nextHeight = canvas.clientHeight;
      if (!nextWidth || !nextHeight) return false;
      if (nextWidth === width && nextHeight === height) return false;
      width = nextWidth;
      height = nextHeight;
      ratio = Math.min(window.devicePixelRatio || 1, width * height > 1_600_000 ? 1.5 : 2);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      // A staggered grid: every other row is shifted by half a step, which reads calmer than squares.
      const step = Math.max(26, Math.sqrt((width * height) / 2600));
      const rowStep = step * 0.866;
      const cols = Math.ceil(width / step) + 2;
      const rows = Math.ceil(height / rowStep) + 2;
      const count = cols * rows;
      xs = new Float32Array(count);
      ys = new Float32Array(count);
      jx = new Float32Array(count);
      jy = new Float32Array(count);
      mags = new Float32Array(count);
      phases = new Float32Array(count);
      speeds = new Float32Array(count);
      depths = new Float32Array(count);
      kinds = new Uint8Array(count);
      let index = 0;
      for (let row = 0; row < rows; row++) {
        const shift = row % 2 ? step / 2 : 0;
        for (let col = 0; col < cols; col++) {
          xs[index] = col * step + shift - step / 2;
          ys[index] = row * rowStep - rowStep / 2;
          // Stars sit off the grid, most are faint and a few are bright: the way a night sky looks.
          jx[index] = (noise(col, row, 7) - 0.5) * step * 0.8;
          jy[index] = (noise(col, row, 8) - 0.5) * rowStep * 0.8;
          const rank = noise(col, row, 1);
          const kind = rank > 1 - SPARKLING ? 2 : rank > 1 - SPARKLING - GLOWING ? 1 : 0;
          kinds[index] = kind;
          mags[index] = kind ? 1 : 0.28 + 0.72 * noise(col, row, 2) ** 1.8;
          phases[index] = noise(col, row, 3) * TAU;
          speeds[index] = 0.0007 + 0.0018 * noise(col, row, 4);
          depths[index] = kind ? 0.5 : noise(col, row, 5) < TWINKLING ? 0.3 + 0.35 * noise(col, row, 6) : 0.08;
          index++;
        }
      }
      return true;
    }

    /** The text blocks on screen, as [left, top, right, bottom] in viewport coordinates. */
    function visibleBlocks(): number[] {
      const boxes: number[] = [];
      for (const block of blocks) {
        const rect = block.getBoundingClientRect();
        if (!rect.width || !rect.height) continue;
        if (rect.bottom < -TEXT_FEATHER || rect.top > height + TEXT_FEATHER) continue;
        boxes.push(rect.left, rect.top, rect.right, rect.bottom);
      }
      return boxes;
    }

    /** 1 away from text, TEXT_FADE inside a text block, a smooth ramp in between. */
    function textFade(x: number, y: number, boxes: number[]): number {
      let fade = 1;
      for (let i = 0; i < boxes.length; i += 4) {
        const dx = Math.max(boxes[i]! - x, 0, x - boxes[i + 2]!);
        const dy = Math.max(boxes[i + 1]! - y, 0, y - boxes[i + 3]!);
        if (dx >= TEXT_FEATHER || dy >= TEXT_FEATHER) continue;
        const t = Math.min(1, Math.hypot(dx, dy) / TEXT_FEATHER);
        const value = TEXT_FADE + (1 - TEXT_FADE) * t * t * (3 - 2 * t);
        if (value < fade) fade = value;
      }
      return fade;
    }

    /** A four-pointed sparkle: two thin diamonds crossing at the star. */
    function sparkle(x: number, y: number, arm: number) {
      const waist = arm * 0.22;
      ctx.beginPath();
      ctx.moveTo(x, y - arm);
      ctx.lineTo(x + waist, y);
      ctx.lineTo(x, y + arm);
      ctx.lineTo(x - waist, y);
      ctx.closePath();
      ctx.moveTo(x - arm, y);
      ctx.lineTo(x, y + waist);
      ctx.lineTo(x + arm, y);
      ctx.lineTo(x, y - waist);
      ctx.closePath();
      ctx.fill();
    }

    function draw(time: number) {
      retintStep(time);
      const still = reduced.matches;
      const phase = still ? 0 : time * SWELL_SPEED;
      const strength = still ? 0 : pointer.strength;
      const live = still ? [] : ripples;
      const reach2 = REACH * REACH;
      const boxes = visibleBlocks();
      const levels = Array.from({ length: LEVELS }, () => new Path2D());
      const lifted: number[] = [];
      // Bright stars and sparkles of the starry sky: x, y, brightness, kind.
      const shining: number[] = [];

      for (let i = 0; i < xs.length; i++) {
        const x = stars ? xs[i]! + jx[i]! : xs[i]!;
        const y = stars ? ys[i]! + jy[i]! : ys[i]!;
        const fade = boxes.length ? textFade(x, y, boxes) : 1;
        let lift = 0;
        let pushX = 0;
        let pushY = 0;
        if (strength > 0.01) {
          const dx = x - pointer.x;
          const dy = y - pointer.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < reach2) {
            const distance = Math.sqrt(d2) || 1;
            const k = (1 - distance / REACH) ** 2 * strength;
            lift = k;
            pushX = (dx / distance) * k * PUSH;
            pushY = (dy / distance) * k * PUSH;
          }
        }
        for (const ripple of live) {
          const age = time - ripple.born;
          const dx = x - ripple.x;
          const dy = y - ripple.y;
          const distance = Math.sqrt(dx * dx + dy * dy) || 1;
          const band = 1 - Math.abs(distance - age * RIPPLE_SPEED) / RIPPLE_WIDTH;
          if (band > 0) {
            const k = band * (1 - age / RIPPLE_LIFE);
            if (k > lift) lift = k;
            pushX += (dx / distance) * k * 6;
            pushY += (dy / distance) * k * 6;
          }
        }
        // Over text the pointer still shows, only quieter.
        lift *= 0.35 + 0.65 * fade;
        // The swell: a soft diagonal band of brightness that drifts across the screen.
        const swell = 0.5 + 0.5 * Math.sin(x * 0.0105 + y * 0.0065 - phase);
        if (lift > 0.03) {
          lifted.push(x + pushX, y + pushY, lift, fade);
        } else if (stars) {
          // Each star twinkles at its own pace; the swell only breathes underneath.
          const twinkle = still
            ? 1 - depths[i]! / 2
            : 1 - depths[i]! * (0.5 + 0.5 * Math.sin(time * speeds[i]! + phases[i]!));
          const brightness = mags[i]! * twinkle * (0.78 + 0.22 * swell) * fade;
          if (kinds[i]) {
            shining.push(x, y, brightness, kinds[i]!);
          } else {
            const radius = 0.7 + 0.6 * mags[i]!;
            const path = levels[Math.min(LEVELS - 1, Math.floor(brightness * LEVELS))]!;
            path.moveTo(x + radius, y);
            path.arc(x, y, radius, 0, TAU);
          }
        } else {
          const brightness = (0.35 + 0.65 * swell) * fade;
          const path = levels[Math.min(LEVELS - 1, Math.floor(brightness * LEVELS))]!;
          path.moveTo(x + RADIUS, y);
          path.arc(x, y, RADIUS, 0, TAU);
        }
      }

      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = `rgb(${base[0]} ${base[1]} ${base[2]})`;
      for (let level = 0; level < LEVELS; level++) {
        ctx.globalAlpha = (base[3] * (level + 0.5)) / LEVELS;
        ctx.fill(levels[level]!);
      }
      // Bright stars: a glow and a white core; sparkles also get their four points.
      for (let i = 0; i < shining.length; i += 4) {
        const x = shining[i]!;
        const y = shining[i + 1]!;
        const brightness = shining[i + 2]!;
        const isSparkle = shining[i + 3] === 2;
        const size = isSparkle ? 20 : 13;
        ctx.globalAlpha = brightness * (isSparkle ? 0.9 : 0.75) * glowStrength;
        ctx.drawImage(glow, x - size / 2, y - size / 2, size, size);
        if (isSparkle) {
          ctx.fillStyle = `rgb(${sparkleColor[0]} ${sparkleColor[1]} ${sparkleColor[2]})`;
          ctx.globalAlpha = Math.min(1, brightness * 1.1);
          sparkle(x, y, 2.6 + 2.4 * brightness);
        }
        ctx.fillStyle = `rgb(${active[0]} ${active[1]} ${active[2]})`;
        ctx.globalAlpha = Math.min(1, brightness);
        ctx.beginPath();
        ctx.arc(x, y, isSparkle ? 1.1 : 1.35, 0, TAU);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      for (let i = 0; i < lifted.length; i += 4) {
        const x = lifted[i]!;
        const y = lifted[i + 1]!;
        const k = lifted[i + 2]!;
        const mix = (from: number, to: number) => from + (to - from) * k;
        const alpha = mix(base[3], active[3]) * (0.35 + 0.65 * lifted[i + 3]!);
        if (stars && k > 0.2) {
          // Next to the pointer the stars flare up.
          const size = 6 + 16 * k;
          ctx.globalAlpha = alpha * k * glowStrength;
          ctx.drawImage(glow, x - size / 2, y - size / 2, size, size);
          ctx.globalAlpha = 1;
        }
        ctx.fillStyle = `rgb(${mix(base[0], active[0])} ${mix(base[1], active[1])} ${mix(base[2], active[2])} / ${alpha})`;
        ctx.beginPath();
        ctx.arc(x, y, RADIUS + GROW * k, 0, TAU);
        ctx.fill();
      }
      lastDraw = time;
      dirty = false;
    }

    function tick(time: number) {
      if (!running) return;
      frame = requestAnimationFrame(tick);
      pointer.x += (pointer.targetX - pointer.x) * 0.2;
      pointer.y += (pointer.targetY - pointer.y) * 0.2;
      pointer.strength += (pointer.target - pointer.strength) * 0.08;
      while (ripples.length && time - ripples[0]!.born > RIPPLE_LIFE) ripples.shift();
      const moving =
        Math.abs(pointer.targetX - pointer.x) > 0.3 ||
        Math.abs(pointer.targetY - pointer.y) > 0.3 ||
        Math.abs(pointer.target - pointer.strength) > 0.01;
      // A re-tint runs at full frame rate: it is short, and steps in color would show.
      if (retint || dirty || moving || ripples.length > 0 || time - lastDraw >= IDLE_FRAME)
        draw(time);
    }

    function play() {
      if (running || reduced.matches || document.hidden) return;
      running = true;
      frame = requestAnimationFrame(tick);
    }

    function pause() {
      running = false;
      cancelAnimationFrame(frame);
    }

    /** One frame soon, for when the loop isn't running (reduced motion). */
    function drawSoon() {
      if (running) {
        dirty = true;
        return;
      }
      if (pending) return;
      pending = requestAnimationFrame((time) => {
        pending = 0;
        draw(time);
      });
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        layout();
        drawSoon();
      }, 120);
    });
    window.addEventListener('scroll', drawSoon, { passive: true });

    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch') return;
        if (pointer.target === 0 && pointer.strength < 0.01) {
          // Appear where the pointer is instead of sliding in from where it was last seen.
          pointer.x = event.clientX;
          pointer.y = event.clientY;
        }
        pointer.targetX = event.clientX;
        pointer.targetY = event.clientY;
        pointer.target = 1;
        play();
      },
      { passive: true },
    );
    document.addEventListener('pointerout', (event) => {
      if (!event.relatedTarget) pointer.target = 0;
    });
    window.addEventListener('blur', () => (pointer.target = 0));

    window.addEventListener(
      'pointerdown',
      (event) => {
        if ((event.target as Element | null)?.closest?.(QUIET)) return;
        ripples.push({ x: event.clientX, y: event.clientY, born: performance.now() });
        if (ripples.length > 4) ripples.shift();
        play();
      },
      { passive: true },
    );

    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    reduced.addEventListener('change', () => {
      if (reduced.matches) {
        pause();
        drawSoon();
      } else {
        play();
      }
    });

    // The theme switch changes the dot colors and the light or starry look; late web fonts move the text blocks.
    new MutationObserver(() => {
      readColors();
      drawSoon();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    document.fonts?.ready.then(drawSoon);

    readColors();
    layout();
    draw(performance.now());
    play();
  }

  const canvas = document.querySelector<HTMLCanvasElement>('canvas.np-dots');
  if (canvas) start(canvas);
</script>

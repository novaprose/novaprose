---
/** Частые вопросы: нативные details/summary — работают без JS и с клавиатуры. */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="np-faq">
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

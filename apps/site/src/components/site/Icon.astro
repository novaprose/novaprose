---
/**
 * Иконки продуктовых страниц: Lucide (контур 2px, 24×24) и знак GitHub из Octicons (залитый).
 * Набор генерируется скриптом scripts/icons.mjs (pnpm icons). Декоративные — aria-hidden.
 */
import { fillIcons, strokeIcons } from './icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className } = Astro.props;
const fill = fillIcons[name];
const body = fill ?? strokeIcons[name] ?? strokeIcons.check;
---

{
  fill ? (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      set:html={body}
    />
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={body}
    />
  )
}

---
import Marketing from '../layouts/Marketing.astro';
import Icon from '../components/site/Icon.astro';
import WaitlistForm from '../components/site/WaitlistForm.astro';
import { t } from '../i18n/site';
---

<Marketing path="/cloud/" title={t.cloud.title} description={t.cloud.lead}>
  <section class="np-hero np-hero-page" aria-labelledby="cloud-title">
    <div class="np-container np-split np-split-top">
      <div class="np-hero-copy">
        <p class="np-eyebrow"><Icon name="sparkles" size={16} />{t.cloud.eyebrow}</p>
        <h1 class="np-h1" id="cloud-title">{t.cloud.title}</h1>
        <p class="np-lead">{t.cloud.lead}</p>
        <p class="np-note">
          {t.cloud.todayText}{' '}
          <a href="/guides/collaboration/">{t.cloud.todayLink}</a>.
        </p>
      </div>
      <WaitlistForm />
    </div>
  </section>

  <section class="np-section np-section-soft" aria-labelledby="cloud-what">
    <div class="np-container">
      <div class="np-section-head">
        <h2 class="np-h2" id="cloud-what">{t.cloud.whatTitle}</h2>
      </div>
      <div class="np-grid np-grid-4">
        {
          t.cloud.items.map((item) => (
            <article class="np-card">
              <span class="np-card-icon">
                <Icon name={item.icon} />
              </span>
              <h3 class="np-h3">{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Marketing>

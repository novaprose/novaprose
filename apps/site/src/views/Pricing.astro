---
import Marketing from '../layouts/Marketing.astro';
import Plans from '../components/site/Plans.astro';
import Faq from '../components/site/Faq.astro';
import { t } from '../i18n/site';
---

<Marketing path="/pricing/" title={t.pricing.pageTitle} description={t.pricing.pageLead}>
  <section class="np-hero np-hero-page" aria-labelledby="pricing-title">
    <div class="np-container">
      <div class="np-hero-copy">
        <h1 class="np-h1" id="pricing-title">{t.pricing.pageTitle}</h1>
        <p class="np-lead">{t.pricing.pageLead}</p>
      </div>
    </div>
  </section>

  <section class="np-section np-section-tight">
    <div class="np-container">
      <Plans />
    </div>
  </section>

  <section class="np-section np-section-soft" aria-labelledby="faq-title">
    <div class="np-container np-split np-split-top">
      <div class="np-split-copy">
        <h2 class="np-h2" id="faq-title">{t.pricing.faqTitle}</h2>
        <p class="np-lead">
          {t.pricing.faqMore} <a href="mailto:hello@novaprose.com">hello@novaprose.com</a>.
        </p>
      </div>
      <Faq items={t.pricing.faq} />
    </div>
  </section>
</Marketing>

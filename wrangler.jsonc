// Cloudflare Workers (static files): the novaprose.com website from apps/site/dist.
// Built and published by Cloudflare Workers Builds on push to main (see docs/RELEASING.md → "Website").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novaprose",
  "compatibility_date": "2026-11-24",
  // The site is served only at novaprose.com (Custom Domains in Cloudflare). The technical *.workers.dev
  // address and preview links are off, so search engines see no copies of the site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./apps/site/dist",
    // Starlight generates 404.html: it is shown for pages that don't exist.
    "not_found_handling": "404-page",
  },
}
